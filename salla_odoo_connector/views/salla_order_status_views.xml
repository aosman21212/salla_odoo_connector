<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salla_order_status_list" model="ir.ui.view">
        <field name="name">salla.order.status.list</field>
        <field name="model">salla.order.status</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="salla_id"/>
                <field name="salla_instance_id"/>
                <field name="color"/>
                <field name="order_count"/>
            </list>
        </field>
    </record>

    <record id="action_salla_order_status_list" model="ir.actions.act_window">
        <field name="name">Salla Order Statuses</field>
        <field name="res_model">salla.order.status</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
