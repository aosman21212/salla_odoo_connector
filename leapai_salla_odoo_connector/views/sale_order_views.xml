<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend sale order form: add Salla smart button + fields -->
    <record id="view_sale_order_form_salla" model="ir.ui.view">
        <field name="name">sale.order.form.salla</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart button -->
            <div name="button_box" position="inside">
                <button name="action_open_salla_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-bag"
                        invisible="not salla_id"
                        title="Open in Salla">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Salla</span>
                        <span class="o_stat_value" invisible="not salla_reference">
                            <field name="salla_reference"/>
                        </span>
                    </div>
                </button>
            </div>

            <!-- Salla reference near client_order_ref -->
            <field name="client_order_ref" position="after">
                <field name="salla_id" invisible="1"/>
                <field name="salla_instance_id" invisible="1"/>
                <field name="salla_status" readonly="1" invisible="not salla_id"/>
            </field>

            <!-- Salla tab (only shown for Salla orders) -->
            <page name="other_information" position="after">
                <page string="🛍 Salla" name="salla_info" invisible="not salla_id">
                    <group>
                        <group string="Salla Order Details">
                            <field name="salla_id" readonly="1"/>
                            <field name="salla_reference" readonly="1"/>
                            <field name="salla_status"/>
                            <field name="salla_instance_id" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <div>
                                <button name="action_open_salla_order"
                                        type="object"
                                        string="🔗 Open in Salla"
                                        class="btn btn-outline-secondary btn-sm me-2"/>
                                <button name="action_push_status_to_salla"
                                        type="object"
                                        string="📤 Push Status to Salla"
                                        class="btn btn-outline-warning btn-sm"/>
                            </div>
                        </group>
                    </group>
                </page>
            </page>

        </field>
    </record>

    <!-- List view with Salla columns -->
    <record id="view_sale_order_list_salla" model="ir.ui.view">
        <field name="name">sale.order.list.salla</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <field name="client_order_ref" position="after">
                <field name="salla_reference" optional="show" string="Salla Ref"/>
                <field name="salla_status" optional="show" string="Salla Status"/>
            </field>
        </field>
    </record>

</odoo>
